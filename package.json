{
  "name": "nutrition-tracker",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "build:db": "python3 db_build/build_db.py",
    "verify:m0": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify_m0.mjs",
    "verify:m1": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify_m1.mjs",
    "verify:m2": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify_m2.mjs",
    "verify:m3": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify_m3.mjs",
    "verify:m4": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify_m4.mjs",
    "verify:m5": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify_m5.mjs",
    "verify:m6": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify_m6.mjs",
    "verify:m7": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/verify_m7.mjs",
    "verify:web": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --disable-warning=DEP0205 --import ./scripts/ts-register.mjs scripts/verify_web.mjs",
    "verify:all": "for m in 0 1 2 3 4 5 6 7; do npm run --silent verify:m$m || exit 1; done && npm run --silent verify:web",
    "build:web": "expo export --platform web",
    "test": "jest"
  },
  "dependencies": {
    "@expo/metro-runtime": "~4.0.1",
    "@react-native-async-storage/async-storage": "1.23.1",
    "@supabase/supabase-js": "^2.108.2",
    "dayjs": "^1.11.13",
    "expo": "~52.0.0",
    "expo-asset": "~11.0.1",
    "expo-constants": "~17.0.3",
    "expo-file-system": "~18.0.4",
    "expo-linear-gradient": "~14.0.2",
    "expo-linking": "~7.0.5",
    "expo-router": "~4.0.9",
    "expo-sqlite": "~15.1.4",
    "expo-status-bar": "~2.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "react-native": "0.76.9",
    "react-native-safe-area-context": "4.12.0",
    "react-native-screens": "~4.4.0",
    "react-native-svg": "15.8.0",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-web": "~0.19.13",
    "sql.js": "^1.14.1",
    "zustand": "^5.0.2"
  },
  "devDependencies": {
    "@babel/core": "^7.25.2",
    "@types/jest": "^29.5.14",
    "@types/react": "~18.3.12",
    "@types/sql.js": "^1.4.11",
    "jest": "^29.7.0",
    "jest-expo": "~52.0.2",
    "typescript": "~5.3.3"
  },
  "private": true
}
