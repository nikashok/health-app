# Serverless AI nutrition lookup (api/lookup.ts on Vercel).
# Copy this file to .env.local for local dev and fill in your real key there.
# NEVER commit a real key — this template ships with placeholders only.
OPENAI_API_KEY=

# Optional. Extract step (strict JSON) model. Defaults to gpt-5.4-mini.
OPENAI_MODEL=gpt-5.4-mini

# Optional. Search step model — MUST support the web_search tool
# (gpt-4.1-mini / gpt-4.1 / gpt-5.4 / gpt-5.5). Defaults to gpt-4.1-mini.
OPENAI_SEARCH_MODEL=gpt-4.1-mini
