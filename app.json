{
  "expo": {
    "name": "Nutrition Tracker",
    "slug": "nutrition-tracker",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "nutritiontracker",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "assetBundlePatterns": ["assets/db/*", "**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.nutritiontracker.app"
    },
    "android": {
      "package": "com.nutritiontracker.app"
    },
    "web": {
      "bundler": "metro",
      "output": "single"
    },
    "plugins": ["expo-router", "expo-sqlite"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
